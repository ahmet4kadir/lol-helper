{
  "name": "lol-helper",
  "version": "0.1.0",
  "description": "League of Legends companion: champ select insights and a movable in-game overlay, built on the official LCU and Live Client Data APIs.",
  "main": "./out/main/index.js",
  "author": "Ahmet Kadir Doğan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "cross-env LOLHELPER_MOCK=1 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "probe:stats": "node scripts/probe-stats.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4",
    "ws": "^8.18.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.ahmetkadir.lolhelper",
    "productName": "LoL Helper",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ahmet4kadir",
        "repo": "lol-helper",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  },
  "homepage": "https://github.com/ahmet4kadir/lol-helper",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmet4kadir/lol-helper.git"
  }
}
